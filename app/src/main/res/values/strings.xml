    <string name="onboarding_welcome_subtitle">A cycle tracker that keeps your data on your phone.</string>
    <string name="onboarding_feature_private">No account, no analytics</string>
    <string name="onboarding_feature_private_body">The app never contacts a server unless you turn on Drive backup.</string>
    <string name="onboarding_feature_ranges">Ranges, not guesses</string>
    <string name="onboarding_feature_ranges_body">Predictions show a date range and how many cycles they rest on.</string>
    <string name="onboarding_feature_open">Open source</string>
    <string name="onboarding_feature_open_body">MIT. The code is public and auditable.</string>
    <string name="onboarding_how_title">How predictions work</string>
    <string name="onboarding_how_body">Only the first day of each period is needed. Temperature, symptoms and everything else are optional.</string>
    <string name="onboarding_how_one">After one complete cycle</string>
    <string name="onboarding_how_one_body">Mensis estimates when your next period starts.</string>
    <string name="onboarding_how_three">After three cycles</string>
    <string name="onboarding_how_three_body">It adds a fertile window and shows how much your cycles vary.</string>
    <string name="onboarding_how_temperature">Temperature confirms ovulation</string>
    <string name="onboarding_how_temperature_body">Log a waking temperature and the app marks the shift when it sees one.</string>
    <string name="onboarding_not_contraception">Predictions are statistics about your own history. They are not contraception.</string>
