    <!-- What to track (design §8) -->
    <string name="track_intro">Decides which fields the daily log shows. Nothing is ever required; the log saves with any fields empty.</string>
    <string name="track_period">Period only</string>
    <string name="track_period_desc">Bleeding days and flow. Enough for period predictions.</string>
    <string name="track_symptoms">Period and symptoms</string>
    <string name="track_symptoms_desc">Adds symptoms, mood, sleep and notes.</string>
    <string name="track_full">Everything, including temperature</string>
    <string name="track_full_desc">Adds waking temperature, cervical mucus and LH tests (sympto-thermal method). Lets Mensis confirm ovulation.</string>
    <string name="track_info">Period predictions need only the first day of each period. Temperature adds ovulation confirmation; without it, ovulation is estimated from cycle lengths and marked as such.</string>
    <string name="track_footer">Hidden fields keep any data already logged. Reminders for temperature appear only with the full set.</string>

