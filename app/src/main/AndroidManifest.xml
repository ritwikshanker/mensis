<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Reminders and the "reconnect your Google account" backup notice post local notifications;
      onboarding step 9 and the Reminders screen ask for this on Android 13+.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Alarms are lost on reboot; reminders are planned again once the phone has started. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Exact reminder times when the user grants it (Reminders screen); never required. Without it a
      reminder arrives within a 15-minute window. USE_EXACT_ALARM is for alarm-clock apps and not used.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      WorkManager declares this for foreground workers. Mensis never runs one (no setForeground, no
      expedited work), so the permission is removed from the merged manifest.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <!--
      Privacy rule 4: no Android auto-backup or device-to-device transfer of app data. The SQLCipher
      database is useless without the device-bound Keystore key; the encrypted Drive backup replaces it.
      Privacy rule 2: cleartext traffic disabled via network_security_config.
    -->
    <application
        android:name=".MensisApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mensis"
        tools:targetApi="37">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mensis"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager is configured by MensisApplication (Hilt workers), not by its default initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- A reminder alarm went off; only the app's own AlarmManager PendingIntent reaches it. -->
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />

        <!-- System broadcasts after which reminders are planned again. -->
        <receiver
            android:name=".notifications.RescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Export "Share file": hands one exported file to the app the user picks, read-only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
