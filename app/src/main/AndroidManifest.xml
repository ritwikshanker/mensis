<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Privacy rule 4: no Android auto-backup or device-to-device transfer of app data. The SQLCipher
      database is useless without the device-bound Keystore key; the encrypted Drive backup replaces it.
      Privacy rule 2: cleartext traffic disabled via network_security_config.
    -->
    <application
        android:name=".MensisApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mensis"
        tools:targetApi="37">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mensis"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
